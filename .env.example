# Long, random secrets. Keep PUBKY_DB_PASSWORD unchanged after the first boot.
PUBKY_DB_PASSWORD=replace-with-a-long-random-password
# Homeserver admin API password; also the dashboard login unless
# PUBKY_DASHBOARD_PASSWORD is set.
PUBKY_ADMIN_PASSWORD=replace-with-a-long-random-password
# PUBKY_DASHBOARD_PASSWORD=

# Public hostname served by your TLS reverse proxy (-> host:6286).
PUBKY_DOMAIN=homeserver.example.com
# Static public IP that TCP 6287 is forwarded from. Published in the PKARR record.
PUBKY_PUBLIC_IP=203.0.113.10

# Host directory holding data/ (config.toml, secret, files) and postgres/.
PUBKY_DATA_DIR=/mnt/pubky
# Host address to bind the reverse-proxy target (6286) and dashboard (8812) to.
PUBKY_BIND_IP=0.0.0.0
PUBKY_DASHBOARD_PORT=8812
